node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
# Every env file, not only the .local variants. The previous pattern
# `.env*.local` left a plain `.env` — the name the Next.js docs use, and the
# one a person types first — tracked. That was survivable while this repo was
# private and is not now.
.env
.env.*
!.env.example
__pycache__/
healthcheck-report.txt
archive-integrity.txt
dist/

# Raw DhowCSD account exports. The instrument rows are useful reference data
# and live, stripped, in backend/reference/. The files as downloaded carry a
# six-line trailer with the account holder's name, email, address, phone,
# CUI and KRA PIN — a trailer that reached this public repository once
# already. tests/unit/no-personal-data.test.ts is the backstop; this is the
# fence in front of it.
Portfolio*.csv
Securities*.csv
Securities*.pdf

# Scratch worktrees created by Claude Code when subagents run with worktree
# isolation. Ephemeral harness state, one full checkout each — 33MB for four.
# Scoped to worktrees/ rather than .claude/ so that genuine project config
# under .claude (settings, skills) would still be tracked if it is ever added.
.claude/worktrees/

# Scratch measurement scripts written at the repo root during a session.
#
# `cls.mjs`, `shot.mjs` and `src.mjs` — one-off Playwright probes for CLS
# sources and screenshots — were swept into a commit by `git add -A` on
# 8 September and shipped as repository content. They are not part of the
# project and nothing references them.
#
# The named files rather than a blanket `*.mjs`: scripts/ is full of .mjs that
# MUST be tracked, and a pattern broad enough to catch scratch would eventually
# catch one of those. Use the scratchpad directory instead of the repo root and
# none of this is needed.
/cls.mjs
/shot.mjs
/src.mjs
/measure.mjs
/audit.mjs
/probe-tmp.mjs
