{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "declaration": true,
    "outDir": "dist/engine",
    "rootDir": "src",
    "skipLibCheck": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/lib/engine.ts",
    "src/lib/financial-engine.ts",
    "src/lib/sell.ts",
    "src/lib/bid.ts",
    "src/lib/predictions.ts",
    "src/lib/market-pulse.ts",
    "src/lib/prices.ts",
    "src/lib/auction-history.ts",
    "src/lib/tbills.ts",
    "src/types/bond.ts"
  ]
}
